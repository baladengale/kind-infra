# Copy to .env at the repo root (gitignored) — sourced by scripts/80-kagent.sh.
# kagent deploys with the Anthropic provider by default.

# ============================================================================
# Required: DeepSeek API key (or any Anthropic-compatible token)
# This is used by the default model config AND the AgentGateway LLM router.
# Get yours at: https://platform.deepseek.com/api_keys
# ============================================================================
ANTHROPIC_API_KEY=

# ============================================================================
# Optional: ByteDance Ark API key (Anthropic-compatible endpoint).
# Set this to enable the ark-model-config (direct) and agw-ark (via
# AgentGateway) backends. The script 35-agentgateway-llm.sh skips Ark
# resources entirely when this is empty.
#
# The Ark endpoint is typically configured in ~/.balarc_ark as:
#   ANTHROPIC_AUTH_TOKEN=ark-...
#   ANTHROPIC_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/coding
#   ANTHROPIC_MODEL=ark-code-latest
#
# The script also checks ANTHROPIC_AUTH_TOKEN as a fallback (sourcing
# ~/.balarc_ark before running make works too).
# ============================================================================
#ANTHROPIC_ARK_AUTH_TOKEN=

# ============================================================================
# Optional: model override (chart default: claude-haiku-4-5)
# ============================================================================
#KAGENT_MODEL=

# ============================================================================
# Optional: Anthropic-compatible endpoint, e.g. DeepSeek:
#   KAGENT_BASE_URL=https://api.deepseek.com/anthropic
#   KAGENT_MODEL=deepseek-v4-flash
# ============================================================================
#KAGENT_BASE_URL=
