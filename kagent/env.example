# Copy to .env at the repo root (gitignored) — sourced by scripts/80-kagent.sh.
# kagent deploys with the Anthropic provider by default.

# Required: Anthropic API key (or any Anthropic-compatible token)
ANTHROPIC_API_KEY=

# Optional: model override (chart default: claude-haiku-4-5)
#KAGENT_MODEL=

# Optional: Anthropic-compatible endpoint, e.g. DeepSeek:
#   KAGENT_BASE_URL=https://api.deepseek.com/anthropic
#   KAGENT_MODEL=deepseek-v4-flash
#KAGENT_BASE_URL=
